extends ../layout 

block styles 
  link(rel="stylesheet", href="/stylesheets/card-set.css")

block content 
    h1= title + " " 


    div.collection-container 
      if !setList.length
        p No sets found

      else 
        div.results-wrapper 
          each set in setList
            a.not-a(href=`/sets/${set.id}`)
              div.result-container
                  p.set-name= `${set.name} ${set.isJapanese ? ' [jp]' : ''}`
                  p.set-series= set.series
                  div.result-info-container
                      p= set.releaseDate.toLocaleDateString()
                      img(src=`${set.symbolUrl || "/images/pokeball.png"}` alt=set.name style="width:30px")

