extends layout 

block styles 
  link(rel="stylesheet", href="/stylesheets/search.css")

block content 
  div.page-wrapper
    h1= title 
    if !card_list.length 
      p Sorry, no results found 

    else
      div.results-wrapper
        each card in card_list 
          - const prices = card.tcgplayer ? card.tcgplayer.prices : null
          
          div.result-container
            div(class=`result-img-container${user_cards.has(card.id) || user_reverse_cards.has(card.id) ? " owned" : ""}`) 
              img(src=card.meta.images.small, alt=card.name)
            div.result-info-container 
              p.result-title= card.name 
              p.result-set= card.set.name 
              p.result-number= card.set.number
              p $#{!card.value.market ? " not available" : card.value.market.toFixed(2)}
              if !user_cards.has(card.id)
                form.add-card-form(method="POST" action=`/collection/cards/${card._id}/update-card-id`) 
                  input#cardId(type="hidden" name="cardId" required="true" value=card.id)
                  button.btn.btn-secondary(type="submit") Update Card ID