extends ../layout 


block styles 
  link(rel="stylesheet", href="/stylesheets/dashboard.css")

block scripts 
  script(src="/javascripts/csv.js" defer)

block content 
  div.page-wrapper
    header.header 
      div.title-container 
        h1= title + " " 

    if need_update
      p(style="color:red") Looks like there is an update. Please click the button to update cards to new version.
      form(method="POST" action="/collection/update-version") 
        button(type="submit") Update to New Version


    if totalCards < 1
      p No cards in collection yet
    else
      div.body
        div.horizontal.kpi-container
          div.kpi
            p.kpi-value=formatMoney(totalValue)
            p.kpi-label=`Total Value` 
          div.kpi
            p.kpi-value=formatNum(totalCards)
            p.kpi-label=`Total Cards` 
          div.kpi
            p.kpi-value=formatNum(totalUniqueCards)
            p.kpi-label=`Unique Cards` 
          div.kpi
            p.kpi-value=formatNum(totalUniqueCards - notUpdated.count)
            p.kpi-label=`Updated API`
          div.kpi
            p.kpi-value=formatNum(totalDuplicates)
            p.kpi-label=`Duplicates`

        div.vertical
          h3 Most Valuable Cards 
          div.horizontal
            - const c_val = mostValuableCards.reduce((acc, next) => acc + next.value.market, 0)
            p=`${formatNum((c_val / totalValue) * 100)}% of Total Value`
          div.horizontal
            each card in mostValuableCards
              div.tcg-card-container  
                a.not-a(href=`/collection/cards/${card._id}`) 
                  div.tcg-card
                    img(src=card.image, alt=card.name)
                p.card-subtext=formatMoney(card.value.market)

        div.vertical
          h3=`Not Upated Yet` 
          div.horizontal
            p=`Current count: ${formatNum(notUpdated.count)}`
          div.horizontal
            each card in notUpdated.sample
              div.tcg-card-container  
                a.not-a(href=`/collection/cards/${card._id}`) 
                  div.tcg-card
                    img(src=card.image, alt=card.name)
        if manualUpdateCards.length > 1
          div.vertical
            h3=`Manual Update Cards` 
            div.horizontal
              p=`Current count: ${formatNum(manualUpdateCards.length)}`
            div.horizontal
              each card in manualUpdateCards.slice(0, sampleSize)
                div.tcg-card-container  
                  a.not-a(href=`/collection/cards/${card._id}`) 
                    div.tcg-card
                      img(src=card.image, alt=card.name)

        div(style="padding-bottom:10px;").vertical
          div.set-completion-header 
            h3="Set Completion (Unique Cards Only)"
            div(style="display:flex;gap:15px;")
              p ▰ Completion
              p ▧ Reverse holo variants
          p(style="font-size:.8rem;color:gray; width:100%") Completion is based on unique card numbers. Reverse holos are tracked as variants.
          div.horizontal 
            each set in cardSets.slice(0, 10)
              div.set-container
                div.set-name-container
                  - const sn = set.name.split(":") 
                  div.set-logo
                    img(src=set.symbolUrl, alt={sn})
                  p.small-txt=sn.length === 1 ? sn[0] : sn[1]
                div.progress-bar 
                  div.progress.progress-reverseHolo(style=`width:${((set.reverseHoloCards / set.setTotal) * 100).toFixed(2)}%`)
                  div.progress(style=`width:${((set.uniqueCards / set.setTotal) * 100).toFixed(2)}%`)
                p(style="font-size:.7rem")=`${set.uniqueCards} ${set.uniqueCards < 100 ? " " : ""}`
                  if set.reverseHoloCards > 0
                    span(style="font-size:.5rem;")=`· ${set.reverseHoloCards} reverse holo`
        
        div.vertical
          h3=`Most Recently Updated` 
          div.horizontal
            each card in recentUpdates
              div.tcg-card-container  
                a.not-a(href=`/collection/cards/${card._id}`) 
                  div.tcg-card
                    img(src=card.image, alt=card.name)
                p.card-subtext=card.value.priceHistory[0][0]        
        
        div.vertical
          h3=`Least Recently Updated` 
          div.horizontal
            each card in staleUpdates
              div.tcg-card-container  
                a.not-a(href=`/collection/cards/${card._id}`) 
                  div.tcg-card
                    img(src=card.image, alt=card.name)
                p.card-subtext=card.value.priceHistory[0][0]
                
        


