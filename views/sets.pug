extends layout 

block styles 
  link(rel="stylesheet", href="/stylesheets/card-set.css")

block scripts 
  script(src="/javascripts/csv.js" defer)

block content 
    h1= title + " " 


    div.collection-container 
      if !setList.length
        p No sets found

      else 
        div.results-wrapper 
            each set in setList
                div.result-container
                    div.result-info-container 
                        a(href=`/sets/${set.id}`)= set.name
                    div
                        img(src=`${set.symbolUrl || "/images/pokeball.png"}` alt=set.name style="height:30px")

