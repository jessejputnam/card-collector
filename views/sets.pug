extends layout 

block styles 
  link(rel="stylesheet", href="/stylesheets/home.css")

block scripts 
  script(src="/javascripts/csv.js" defer)

block content 
  div.page-wrapper
    header.home-header 
      div.title-container 
        h1= title + " " 


    div.collection-container 
      if !setList.length
        p No sets found

      else 
        each set in setList
          div.collection-item 
            div.collection-item-details
                div
                  p.collection-card-name= set.name      

