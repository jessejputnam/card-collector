extends layout 

block content 
  h1= title 

  div 
    each set in sets 
        p= `${set.name} (${set.id}) - Released on ${set.releaseDate.toDateString()}` 
        form.form-wrapper(method="POST" action=`/collection/cards/${card._id}/update-card-set`) 
          input#setId(type="hidden" name="setId" required="true" value=set.id)
          button.btn.btn-secondary(type="submit" style="margin-bottom:15px") Update to this Set

