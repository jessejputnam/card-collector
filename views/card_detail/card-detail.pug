extends ../layout 

block styles  
  link(rel="stylesheet" href="/stylesheets/detail.css")

block scripts 
  script(src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js")
  script(src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns")
  script(type="module" src="/javascripts/scriptDetail.js" defer)

block content 

  script.
    window.priceHistory = !{JSON.stringify(card.value.priceHistory)}
  - const priceUpdateMsg = (card) => `This will change your price update to ${!card.value.maualUpdate ? "manual. While manual, you will need to input the price yourself to update" : "auto. While auto, price updates will fetch the latest US market price from TCG Player."}`
  if msg

    div#msg.msg-container
      p= msg

  div#auto-update-form-container.form-separator.auto-update-container
    div#close-btn.close-btn ❌ 
      p close
    h3 Change Price Update Method
    p= priceUpdateMsg(card)
    form.auto-update-form-form(method="POST" action=`/collection/cards/${card._id}/change-update-value`)
      input(type="hidden" name="cardId" required="true" value=card._id)
      input(type="hidden" name="isManual" required="true" value=`${!card.value.manualUpdate}` )
      button.btn.btn-primary(type="submit")= `Change to ${card.value.manualUpdate ? "auto" : "manual"}`

  div.page-wrapper
    div.card-detail-container 
      div.detail-img-container 
        img#cardImg(src=card.meta.images.large alt=card.name onerror="/images/missingno.png")

      div.detail-info-container
        div.info-container.info-card-container
          h2(style="font-size:1.2rem") #{card.name}
            if card.meta.rarity.reverseHolo 
              em(style="font-size:.7rem;color:silver")  Reverse Holo
            if card.value.priceType[0] === "1"
              em(style="font-size:.7rem;color:silver")  1st Edition
            if (card.custom)
              a(href=`/collection/cards/${card._id}/edit` style="margin-left:15px;") edit
          em= card.meta.rarity.type

        div.info-container.info-set-container 
          if !card.set.id
            p(style="font-size:.8rem")= `Old Data: ${card.oldSetData}`
            form.select-set-form(method="POST" action=`/collection/cards/${card._id}/update-card-set`) 
              input(type="hidden" name="objId" required='true' value=card._id)
              div.select-set
                input#setSearch(type="text" placeholder="Search cards…")
                select.select#newSetId(type='select' name="newSetId" required="true") 
                  option(value="none" selected=true disabled=true)
                  each set in sets 
                    option(value=set.id)= `${set.name} [${set.series}]`
              button#saveSetBtn.btn.btn-secondary(type="submit" disabled=true) Select Set
          else 
            div 
              img#symbolImg(src=card.set.symbolUrl, alt=card.set.name height="40px")
              div
                p #{card.set.name} 
                p.small-text= card.set.series
                  span(style="font-size:.6rem; color:gray")  (#{card.set.releaseDate && card.set.releaseDate.toLocaleDateString()})
                p.small-text= `${card.meta.setNumber}/${card.set.cardCount}`

        - const sinceAdded = card.value.priceHistory.length > 1 ? card.value.market - card.value.priceHistory.at(-1)[1] : null
        - const sinceLastUpdate = card.value.priceHistory.length > 1 ? card.value.market - card.value.priceHistory.at(1)[1] : null
        - const sinceAddedClass = sinceAdded > 0 ? "positive" : "negative"
        - const sinceLastUpdateClass = sinceLastUpdate > 0 ? "positive" : "negative"
        div.info-container.info-market-container
          div.current-price-container
            p Current Market Value: 
            h2= `${curr === "eur" ? "€" : "$"}${(card.value.market * curr_convert).toFixed(2)}`
            div.delta-container
              div.delta-titles
                p.delta Since Added
                p.delta Since Last Update
              div.delta-values
                p(class=sinceAddedClass)=`${sinceAdded > 0 ? `⬆︎` : sinceAdded == null ? "" : `⬇︎`}${sinceAdded == null ? "--" : formatMoney(Math.abs(sinceAdded))}`
                p(class=sinceLastUpdateClass)=`${sinceLastUpdate > 0 ? `⬆︎` : sinceLastUpdate == null ? "" : `⬇︎`}${sinceLastUpdate == null ? "--" : formatMoney(Math.abs(sinceLastUpdate))}`
          h3(style="font-size:1rem") Price over time 
          div.blinder-hi
          div.blinder-low
          div.price-history-container
            ul 
              each pricePoint in card.value.priceHistory 
                li.small-text= `${pricePoint[0]}: ` 
                  span.small-text= ` ${curr === "eur" ? "€" : "$"}${(Number(pricePoint[1]) * curr_convert).toFixed(2)}`
          div
            canvas#priceChart

    div.card-edits-container
      div.form-separator
        form.card-edit-rarity-form(method="POST" action=`/collection/cards/${card._id}/edit-rarity`)
          input(type="hidden" name="objId" required="true" value=card._id)
          input(type="number" name="rarity" required="true" value=card.meta.rarity.grade)
          button.btn.btn-primary(type="submit") Edit Rarity 

      div.form-separator
        form.card-edit-rarity-form(method="POST" action=`/collection/cards/${card._id}/update-count`)
          input(type="hidden" name="cardId" required="true" value=card._id)
          input(type="number" name="count" required="true" value=(card.value.count || 1) min="1")
          button.btn.btn-primary(type="submit") Edit Count 


      form.card-edit-form(method="POST" action=`/collection/cards/${card._id}/select-binder`) 
        input(type="hidden" name="objId" required='true' value=card._id)
        select.select#binder(type='select' name="binder" required="true") 
          option(value="none" selected=(!card.binder))
          each binder in binders 
            option(value=binder selected=(card.binder === binder))= binder
        button.btn.btn-secondary(type="submit") Select Binder

      div.form-separator
        div#auto-update-toggle(class=`auto-update${card.value.manualUpdate ? " manual" : ""}`)= `Change to ${card.value.manualUpdate ? "auto" : "manual"} update`
        if (card.value.manualUpdate)
          form.card-edit-form(method="POST" action=`/collection/cards/${card._id}/update-value`)
            input(type="number" step="0.01" min="0.01" name="cardValue" required="true" placeholder=card.value.market)
            input(type="hidden" name="cardId" required="true" value=card.id)
            input(type="hidden" name="cardValueType" required="true" value=card.value.priceType)
            button.btn.secondary-btn(type="submit") Update Price
        else 
          if !card.oldId
            if !card.set.id
                p(style="font-size:.8rem") Update card set above first
            else
              a(href=`/collection/cards/${card._id}/sync-price-api?pokeName=${card.name}&pokeSet=${card.set.id}&priceType=${card.value.priceType}&lang=${card.lang}`) 
                button.btn.secondary-btn(type="button") Price API Sync
            p(style="font-size:.7rem;font-style:italic") Update needed for Price API
          else
            form.card-edit-form(method="POST" action=`/collection/cards/${card._id}/update-value`)
              input(type="hidden" name="cardId" required="true" value=card.id)
              input(type="hidden" name="cardValueType" required="true" value=card.value.priceType)
              button.btn.secondary-btn(type="submit") Update Price
            

    div.delete-card-container
      div.delete-card 
        a(href=`/collection/cards/${card._id}/delete`) Delete Card